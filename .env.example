# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). NUNCA envie o .env.local para o GitHub.
#
# Sem estas variáveis o sistema roda em "modo demonstração", com dados de exemplo.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Endereço público do site (usado no link de acompanhamento enviado por WhatsApp e no QR code do certificado).
# Ex.: https://erstudiodental.com.br  (sem barra no fim). Se ficar vazio, usa o endereço de onde o painel foi aberto.
NEXT_PUBLIC_SITE_URL=
